{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "updater-process",
  "description": "Allow updater checks/installs and app relaunch.",
  "windows": ["*"],
  "permissions": [
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "updater:allow-downloadAndInstall",
    "process:default",
    "process:allow-restart",
    "process:allow-relaunch"
  ]
}